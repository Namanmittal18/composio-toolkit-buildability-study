# Copy to .env and fill in. NEVER commit .env.
# The deterministic stages (validation, scoring, analytics, accuracy, site build)
# need NO keys. Keys are only required to run the LLM+search extraction stage
# (scripts/run_research.py) programmatically.

# --- LLM provider (choose one) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# --- Web search provider ---
TAVILY_API_KEY=

# --- Optional: Composio corroboration (independent verification source) ---
# COMPOSIO_API_KEY=
